# TrafficPulse-X Environment Configuration Template
# Copy this file to .env and configure local overrides.
# Never commit real credentials or API keys to version control.

# --- Backend Server Configuration ---
HOST=127.0.0.1
PORT=8000

# --- Frontend API Endpoint ---
# Optional: Base URL for frontend API client (defaults to http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# --- Assistant Integration (Optional) ---
# Optional: Google Gemini API key for external LLM reasoning in the domain assistant.
# If omitted or empty, the assistant uses built-in local domain knowledge retrieval without error.
GEMINI_API_KEY=

# --- External Streaming Adapter (Optional) ---
# Optional: URL endpoint for external live traffic telemetry feed.
# If omitted or unconfigured, the system defaults to Historical Replay mode (no fabricated data).
LIVE_STREAMING_ENDPOINT=
